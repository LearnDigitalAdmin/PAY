+// ============= KENYA BANKS ONLY (settlement picker) =============
+const PAYSTACK_TILL_CODE = "MPTILL";
+const MOBILE_MONEY_CODES = new Set(["MPESA", "MPPAYBILL", "MPTILL", "ATL", "AIRTEL-KE"]);
+
+async function kenyaBanksOnly(secret: string): Promise<{ name: string; code: string }[]> {
+  const all = (await getPaystackBanks(secret, "kenya")) ?? [];
+  return all
+    .filter((b) => b?.name && b?.code
+      && b.active !== false && !b.is_deleted
+      && !String(b.type ?? "").startsWith("mobile_money")
+      && !MOBILE_MONEY_CODES.has(String(b.code).toUpperCase())
+      && !/m-pesa|airtel/i.test(b.name))
+    .map((b) => ({ name: b.name as string, code: b.code as string }))
+    .sort((a, b) => a.name.localeCompare(b.name));
+}
+
+export const listKenyaBanks = onCall({
+  timeoutSeconds: 30,
+  memory: "256MiB",
+  maxInstances: 10,
+  region: "africa-south1",
+  cors: true,
+  secrets: [PAYSTACK_SECRET_KEY],
+}, async (request) => {
+  if (!request.auth) throw new HttpsError("unauthenticated", "User must be authenticated");
+  return { banks: await kenyaBanksOnly(PAYSTACK_SECRET_KEY.value()) };
+});
+
