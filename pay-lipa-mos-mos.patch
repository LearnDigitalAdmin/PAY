+++ b/functions/src/lmm/invoices.ts
@@ -0,0 +1,71 @@
+// Reading a tenant's open invoices and crediting a settled amount to them, oldest first. Same fields and the same exactly-once guard
+// (`paystackRefs`) as the rest of PAY, so PMS and the reminder jobs keep working unchanged: a part-payment leaves status "partial".
+import * as admin from "firebase-admin";
+
+const db = () => admin.firestore();
+const r2 = (n: number) => Math.round(n * 100) / 100;
+
+export interface OpenInvoice { id: string; billingMonth: string; dueDate: string; outstandingMinor: number }
+
+/** The tenant's unpaid invoices, oldest due date first. */
+export async function openInvoices(agentId: string, tenantId: string): Promise<OpenInvoice[]> {
+  const base = db().collection("users").doc(agentId).collection("invoices");
+  let snap = await base.where("tenantId", "==", Number(tenantId)).get();
+  if (snap.empty) snap = await base.where("tenantId", "==", tenantId).get();
+  return snap.docs
+    .map((d) => { const x = d.data(); return { id: d.id, billingMonth: String(x.billingMonth ?? ""), dueDate: String(x.dueDate ?? ""), isPaid: x.isPaid === true, total: Number(x.totalAmount) || 0, paid: Number(x.amountPaid) || 0 }; })
+    .filter((x) => !x.isPaid && x.total - x.paid > 0.004)
+    .map((x) => ({ id: x.id, billingMonth: x.billingMonth, dueDate: x.dueDate, outstandingMinor: Math.round((x.total - x.paid) * 100) }))
+    .sort((a, b) => (a.dueDate || a.billingMonth).localeCompare(b.dueDate || b.billingMonth) || a.id.localeCompare(b.id));
+}
+
+/** Credits `amountMinor` to one invoice exactly once per `reference`. Returns what was applied (never more than the invoice still owed). */
+export async function creditInvoice(agentId: string, invoiceId: string, reference: string, amountMinor: number): Promise<{ appliedMinor: number; isPaid: boolean } | null> {
+  const ref = db().collection("users").doc(agentId).collection("invoices").doc(invoiceId);
+  return db().runTransaction(async (t) => {
+    const snap = await t.get(ref);
+    if (!snap.exists) return null;
+    const inv = snap.data() as Record<string, any>;
+    const total = Number(inv.totalAmount) || 0;
+    const before = Number(inv.amountPaid) || 0;
+    const refs: string[] = Array.isArray(inv.paystackRefs) ? inv.paystackRefs : [];
+    if (refs.includes(reference)) return { appliedMinor: 0, isPaid: before >= total - 0.005 };
+    const amountPaid = Math.min(r2(before + amountMinor / 100), total);
+    const appliedMinor = Math.round((amountPaid - before) * 100);
+    const isPaid = amountPaid >= total - 0.005;
+    t.update(ref, {
+      amountPaid, arrears: Math.max(0, r2(total - amountPaid)), isPaid, status: isPaid ? "paid" : "partial",
+      paidDate: isPaid ? new Date().toISOString().split("T")[0] : inv.paidDate ?? null,
+      paymentReference: reference, paystackRefs: admin.firestore.FieldValue.arrayUnion(reference), paidNotifiedAmount: amountPaid, hasPaid: isPaid,
+      lastModified: new Date().toISOString(),
+    });
+    return { appliedMinor, isPaid };
+  });
+}
+
+export interface Allocation { lines: { invoiceId: string; billingMonth: string; minor: number }[]; leftMinor: number }
+/** Decides, once, which invoices a settled amount goes to (oldest first). Pure given the open invoices. */
+export function allocate(open: OpenInvoice[], amountMinor: number): Allocation {
+  let left = amountMinor; const lines: Allocation["lines"] = [];
+  for (const inv of open) {
+    if (left <= 0) break;
+    const give = Math.min(left, inv.outstandingMinor);
+    if (give > 0) { lines.push({ invoiceId: inv.id, billingMonth: inv.billingMonth, minor: give }); left -= give; }
+  }
+  return { lines, leftMinor: left };
+}
+
+/** Applies a stored allocation. Safe to run again: each invoice is credited once per `settlementId:invoiceId`. */
+export async function applyAllocation(agentId: string, tenantId: string, tenantName: string, settlementId: string, a: Allocation): Promise<void> {
+  for (const line of a.lines) {
+    const res = await creditInvoice(agentId, line.invoiceId, `${settlementId}:${line.invoiceId}`, line.minor);
+    if (!res || res.appliedMinor <= 0) continue;
+    // the tenant's payment history (same place the normal rent flow writes it)
+    await db().collection("payments").doc(String(tenantId)).collection("billingMonths").doc(line.billingMonth || "unknown").set({
+      payments: admin.firestore.FieldValue.arrayUnion({
+        userName: tenantName, agentId, amount: res.appliedMinor / 100, invoiceId: line.invoiceId, billingMonth: line.billingMonth, currency: "KES",
+        reference: `${settlementId}:${line.invoiceId}`, status: "success", provider: "lipa-mos-mos", initiatedAt: new Date().toISOString(),
+      }), lastUpdated: admin.firestore.FieldValue.serverTimestamp(),
+    }, { merge: true });
+  }
+}
diff --git a/functions/src/lmm/plan.ts b/functions/src/lmm/plan.ts
new file mode 100644
index 0000000..8a2f668
--- /dev/null
+++ b/functions/src/lmm/plan.ts
@@ -0,0 +1,180 @@
+// Lipa Mos Mos plans and the tenant-facing callables. Public callables like processPayment: nothing in a request can choose WHERE
+// money goes (that is the landlord's sealed recipient) or HOW MUCH is credited (recomputed here and verified with Paystack later).
+import * as admin from "firebase-admin";
+import axios from "axios";
+import * as crypto from "crypto";
+import { HttpsError, onCall, CallableRequest } from "firebase-functions/v2/https";
+import { PAYSTACK_API_BASE, PAYSTACK_SECRET_KEY } from "../desk/paystack";
+import { checkSafaricomPhone, toMsisdn } from "../phone/safaricom";
+import { FREQUENCY_DAYS, LMM, isFrequency, type Frequency } from "./config";
+import { chargeFor, isValidCredit } from "./fees";
+import { openInvoices } from "./invoices";
+import { sendOnce, lmmText } from "./sms";
+
+const db = () => admin.firestore();
+export const plansCol = () => db().collection("lmm_plans");
+export const paymentsCol = () => db().collection("lmm_payments");
+
+export interface PlanDoc {
+  agentId: string; tenantId: string; tenantName: string; tenantPhone: string; frequency: Frequency; status: "active" | "paused";
+  creditedMinor: number;     // confirmed by Paystack, waiting in Samuhia's account for the next settlement
+  inFlightMinor: number;     // being transferred to the landlord right now
+  settledTotalMinor: number; unappliedMinor: number;   // paid out to the landlord but not yet matched to an invoice
+  settleSeq: number; lastPaymentAt: number; lastSmsAt: number; missedCount: number; milestonesSent: number[];
+  createdAt: number;
+}
+export const planIdOf = (agentId: string, tenantId: string): string => `${agentId}_${tenantId}`;
+const asId = (v: unknown, label: string): string => {
+  const s = String(v ?? "").trim();
+  if (!/^[A-Za-z0-9_-]{1,80}$/.test(s)) throw new HttpsError("invalid-argument", `${label} is not valid`);
+  return s;
+};
+
+/** Lipa Mos Mos is offered only when the landlord has a sealed, active recipient and the feature has not been paused. (Firestore can only pause it.) */
+export async function lmmAvailable(agentId: string): Promise<{ ok: true } | { ok: false; reason: string }> {
+  const [cfg, rec] = await Promise.all([db().collection("lmm_config").doc("global").get(), db().collection("lmm_recipients").doc(agentId).get()]);
+  if (cfg.exists && cfg.data()?.enabled === false) return { ok: false, reason: "Lipa Mos Mos is paused right now. Please try again later." };
+  const r = rec.data();
+  if (!r || r.status !== "active") return { ok: false, reason: "This landlord has not enabled Lipa Mos Mos yet." };
+  return { ok: true };
+}
+
+async function loadTenant(agentId: string, tenantId: string) {
+  const snap = await db().collection("users").doc(agentId).collection("tenants").doc(tenantId).get();
+  if (!snap.exists) throw new HttpsError("not-found", "Tenant not found");
+  const t = snap.data() as Record<string, any>;
+  return { name: String(t.name ?? ""), phone: String(t.phone ?? ""), rentMinor: Math.max(0, Math.round((Number(t.rentAmount) || 0) * 100)), active: t.isActive !== false };
+}
+
+/** What the tenant owes right now: every open invoice (less money already paid to the landlord but not yet matched), else one month's rent. */
+export async function resolveTarget(agentId: string, tenantId: string, plan?: Pick<PlanDoc, "unappliedMinor">): Promise<{ targetMinor: number; basis: "invoices" | "rent" }> {
+  const open = await openInvoices(agentId, tenantId);
+  const unapplied = plan?.unappliedMinor ?? 0;
+  if (open.length > 0) return { targetMinor: Math.max(0, open.reduce((s, i) => s + i.outstandingMinor, 0) - unapplied), basis: "invoices" };
+  const t = await loadTenant(agentId, tenantId);
+  return { targetMinor: Math.max(0, t.rentMinor - unapplied), basis: "rent" };
+}
+
+/** Settlement day: the next 5th (Nairobi time), as YYYY-MM-DD. */
+export function nextSettleOn(now: number): string {
+  const d = new Date(now + 3 * 3_600_000);
+  let y = d.getUTCFullYear(), m = d.getUTCMonth();
+  if (d.getUTCDate() > LMM.SETTLE_DAY) { m += 1; if (m > 11) { m = 0; y += 1; } }
+  return `${y}-${String(m + 1).padStart(2, "0")}-${String(LMM.SETTLE_DAY).padStart(2, "0")}`;
+}
+
+/** A sensible instalment: what is left, spread over the payments between now and the 5th (never below the minimum, never above what is owed). */
+export function suggestInstalment(remainingMinor: number, frequency: Frequency, now: number): number {
+  if (remainingMinor <= 0) return 0;
+  const days = Math.max(1, Math.round((Date.parse(`${nextSettleOn(now)}T00:00:00+03:00`) - now) / 86_400_000));
+  const periods = Math.max(1, Math.floor(days / FREQUENCY_DAYS[frequency]));
+  const each = Math.ceil(remainingMinor / periods / 100) * 100;
+  return Math.min(remainingMinor, Math.max(LMM.MIN_CREDIT_MINOR, Math.min(each, LMM.MAX_CREDIT_MINOR)));
+}
+
+async function ensurePlan(agentId: string, tenantId: string, frequency: Frequency, now: number): Promise<{ id: string; plan: PlanDoc; created: boolean }> {
+  const id = planIdOf(agentId, tenantId);
+  const ref = plansCol().doc(id);
+  const snap = await ref.get();
+  if (snap.exists) {
+    const p = snap.data() as PlanDoc;
+    if (p.frequency !== frequency) await ref.update({ frequency });
+    return { id, plan: { ...p, frequency }, created: false };
+  }
+  const t = await loadTenant(agentId, tenantId);
+  if (!t.active) throw new HttpsError("failed-precondition", "This tenancy is not active");
+  const plan: PlanDoc = {
+    agentId, tenantId, tenantName: t.name, tenantPhone: t.phone, frequency, status: "active", creditedMinor: 0, inFlightMinor: 0, settledTotalMinor: 0,
+    unappliedMinor: 0, settleSeq: 0, lastPaymentAt: 0, lastSmsAt: 0, missedCount: 0, milestonesSent: [], createdAt: now,
+  };
+  try { await ref.create(plan); } catch (e) { if ((e as { code?: number }).code !== 6) throw e; }
+  return { id, plan, created: true };
+}
+
+const view = async (id: string, plan: PlanDoc, now: number) => {
+  const { targetMinor, basis } = await resolveTarget(plan.agentId, plan.tenantId, plan);
+  const remaining = Math.max(0, targetMinor - plan.creditedMinor);
+  return {
+    planId: id, frequency: plan.frequency, status: plan.status, basis, targetMinor, creditedMinor: plan.creditedMinor, remainingMinor: remaining,
+    pct: targetMinor > 0 ? Math.min(100, Math.floor((plan.creditedMinor * 100) / targetMinor)) : 100,
+    settlesOn: nextSettleOn(now), suggestedMinor: suggestInstalment(remaining, plan.frequency, now),
+  };
+};
+
+type Req = { agentId?: unknown; tenantId?: unknown; frequency?: unknown; amount?: unknown; phone?: unknown };
+const opts = { region: "africa-south1", cors: true, timeoutSeconds: 60, memory: "256MiB" as const, maxInstances: 10 };
+
+export const lmm_getPlan = onCall(opts, async (request: CallableRequest<Req>) => {
+  const agentId = asId(request.data?.agentId, "agentId"), tenantId = asId(request.data?.tenantId, "tenantId");
+  const avail = await lmmAvailable(agentId);
+  if (!avail.ok) return { available: false, reason: avail.reason };
+  const snap = await plansCol().doc(planIdOf(agentId, tenantId)).get();
+  const now = Date.now();
+  if (!snap.exists) {
+    const { targetMinor, basis } = await resolveTarget(agentId, tenantId);
+    return { available: true, plan: null, targetMinor, basis, settlesOn: nextSettleOn(now), suggestedMinor: suggestInstalment(targetMinor, "weekly", now) };
+  }
+  return { available: true, plan: await view(snap.id, snap.data() as PlanDoc, now) };
+});
+
+export const lmm_start = onCall(opts, async (request: CallableRequest<Req>) => {
+  const agentId = asId(request.data?.agentId, "agentId"), tenantId = asId(request.data?.tenantId, "tenantId");
+  if (!isFrequency(request.data?.frequency)) throw new HttpsError("invalid-argument", "Choose daily, weekly or biweekly");
+  const avail = await lmmAvailable(agentId);
+  if (!avail.ok) throw new HttpsError("failed-precondition", avail.reason);
+  const now = Date.now();
+  const { id, plan, created } = await ensurePlan(agentId, tenantId, request.data.frequency, now);
+  const v = await view(id, plan, now);
+  if (created && plan.tenantPhone && v.targetMinor > 0) {
+    await sendOnce(`start_${id}`, toMsisdn(plan.tenantPhone), lmmText.started({ name: plan.tenantName, targetMinor: v.targetMinor }));
+  }
+  return { available: true, plan: v };
+});
+
+export const lmm_pay = onCall({ ...opts, secrets: [PAYSTACK_SECRET_KEY] }, async (request: CallableRequest<Req>) => {
+  const agentId = asId(request.data?.agentId, "agentId"), tenantId = asId(request.data?.tenantId, "tenantId");
+  const phone = checkSafaricomPhone(request.data?.phone);
+  if (!phone.ok) throw new HttpsError("invalid-argument", phone.message);
+  const credit = Math.round(Number(request.data?.amount) * 100);
+  if (!isValidCredit(credit)) throw new HttpsError("invalid-argument", `Enter a whole-shilling amount from KES ${LMM.MIN_CREDIT_MINOR / 100} to KES ${(LMM.MAX_CREDIT_MINOR / 100).toLocaleString("en-KE")}`);
+  const avail = await lmmAvailable(agentId);
+  if (!avail.ok) throw new HttpsError("failed-precondition", avail.reason);
+
+  const now = Date.now();
+  const freq: Frequency = isFrequency(request.data?.frequency) ? request.data.frequency : "weekly";
+  const { id, plan } = await ensurePlan(agentId, tenantId, freq, now);
+  if (plan.status !== "active") throw new HttpsError("failed-precondition", "This plan is paused");
+  const { targetMinor } = await resolveTarget(agentId, tenantId, plan);
+  const remaining = targetMinor - plan.creditedMinor;
+  if (remaining <= 0) throw new HttpsError("failed-precondition", "Your rent is already fully covered. Your landlord will be paid shortly.");
+  if (credit > remaining) throw new HttpsError("invalid-argument", `That is more than you owe. The balance is KES ${(remaining / 100).toLocaleString("en-KE")}.`);
+
+  // no double prompts, no runaway attempts
+  const recent = await paymentsCol().where("planId", "==", id).where("createdAt", ">", now - 24 * 3_600_000).get();
+  if (recent.docs.some((d) => d.data().status === "initiating" || (d.data().status === "pending" && now - Number(d.data().createdAt) < 3 * 60_000))) {
+    throw new HttpsError("failed-precondition", "A payment prompt is already waiting on your phone. Please finish it, or wait a few minutes.");
+  }
+  if (recent.size >= 20) throw new HttpsError("resource-exhausted", "Too many attempts today. Please try again tomorrow.");
+
+  const c = chargeFor(credit);
+  const reference = `LMM_${tenantId}_${now.toString(36)}${crypto.randomBytes(3).toString("hex")}`.slice(0, 60);
+  const email = `tenant${tenantId}@samuhia.co.ke`;
+  await paymentsCol().doc(reference).set({
+    reference, planId: id, agentId, tenantId, phone: phone.e164, creditMinor: c.creditMinor, chargeMinor: c.chargeMinor, surchargeMinor: c.surchargeMinor,
+    surchargeBps: c.surchargeBps, status: "initiating", settled: false, createdAt: now,
+  });
+  try {
+    // NO split_code and NO subaccount: the money lands in Samuhia's own Paystack balance and waits for settlement.
+    const res = await axios.post(`${PAYSTACK_API_BASE}/charge`, {
+      email, amount: c.chargeMinor, currency: "KES", mobile_money: { phone: phone.e164, provider: "mpesa" }, reference,
+      metadata: { lmm: true, planId: id, creditMinor: c.creditMinor, chargeMinor: c.chargeMinor },
+    }, { headers: { Authorization: `Bearer ${PAYSTACK_SECRET_KEY.value()}`, "Content-Type": "application/json" }, timeout: 30_000 });
+    if (!res.data?.status) throw new Error(res.data?.message || "Paystack refused the charge");
+    await paymentsCol().doc(reference).update({ status: "pending" });
+    return { reference, status: res.data.data?.status ?? "pending", displayText: res.data.data?.display_text || "Check your phone for the M-PESA prompt", creditMinor: c.creditMinor, chargeMinor: c.chargeMinor, surchargeMinor: c.surchargeMinor };
+  } catch (err) {
+    await paymentsCol().doc(reference).update({ status: "failed", error: String((err as Error)?.message ?? err).slice(0, 200) });
+    const msg = (err as { response?: { data?: { message?: string } } })?.response?.data?.message || (err as Error)?.message || "Could not start the payment";
+    throw new HttpsError("internal", `Payment could not be started: ${msg}`);
+  }
+});
diff --git a/functions/src/lmm/recipient.ts b/functions/src/lmm/recipient.ts
new file mode 100644
index 0000000..f668aab
--- /dev/null
+++ b/functions/src/lmm/recipient.ts
@@ -0,0 +1,87 @@
+// The landlord's TRANSFER recipient. Created only from a request the landlord themself signed in to make (never from whatever is in
+// Firestore later), sealed with a secret, and re-checked against Paystack immediately before every transfer.
+import * as admin from "firebase-admin";
+import axios from "axios";
+import { PAYSTACK_API_BASE } from "../desk/paystack";
+import { alertOps } from "./alert";
+import { fingerprint, sameSeal, sealRecipient } from "./seal";
+
+export type RecipientType = "mobile_money" | "mobile_money_business" | "kepss";
+export interface RecipientDoc {
+  landlordId: string; recipientCode: string; type: RecipientType; bankCode: string; fp: string; last4: string; name: string;
+  status: "active" | "unsupported"; reason?: string; seal: string; createdAt: admin.firestore.FieldValue | number;
+}
+const col = () => admin.firestore().collection("lmm_recipients");
+const auth = (secret: string) => ({ Authorization: `Bearer ${secret}`, "Content-Type": "application/json" });
+
+/** Which Paystack recipient type a landlord's settlement choice maps to. Airtel and Paybill cannot be sent to, so they get no plan. */
+export function recipientSpec(i: { settlementType: string; bankCode: string; accountNumber: string }):
+  { ok: true; type: RecipientType; bankCode: string; accountNumber: string } | { ok: false; reason: string } {
+  const t = String(i.settlementType || "").toLowerCase();
+  const code = String(i.bankCode || "").trim();
+  const acct = String(i.accountNumber || "").replace(/\s+/g, "");
+  if (!acct) return { ok: false, reason: "no account number" };
+  if (t === "airtel-ke" || /airtel/i.test(code)) return { ok: false, reason: "Airtel Money cannot receive transfers" };
+  if (t === "paybill" || /paybill/i.test(code)) return { ok: false, reason: "Paybill needs an account reference and is not supported" };
+  if (t === "till") return { ok: true, type: "mobile_money_business", bankCode: "MPTILL", accountNumber: acct };
+  if (t === "mpesa" || code.toUpperCase() === "MPESA") return { ok: true, type: "mobile_money", bankCode: "MPESA", accountNumber: acct };
+  if (code) return { ok: true, type: "kepss", bankCode: code, accountNumber: acct };
+  return { ok: false, reason: "unknown settlement type" };
+}
+
+/** Creates (or replaces) the landlord's sealed recipient. Safe to call again with the same details. Never throws: no recipient just means no Lipa Mos Mos. */
+export async function createSealedRecipient(
+  secrets: { paystack: string; seal: string },
+  i: { landlordId: string; settlementType: string; bankCode: string; accountNumber: string; name: string },
+): Promise<{ ok: boolean; reason?: string }> {
+  const spec = recipientSpec(i);
+  const fpOf = (bank: string, acct: string) => fingerprint(secrets.seal, bank, acct);
+  if (!spec.ok) {
+    const doc: RecipientDoc = { landlordId: i.landlordId, recipientCode: "", type: "mobile_money", bankCode: "", fp: "", last4: "", name: i.name, status: "unsupported", reason: spec.reason, seal: "", createdAt: Date.now() };
+    await col().doc(i.landlordId).set(doc);
+    return { ok: false, reason: spec.reason };
+  }
+  try {
+    const res = await axios.post(`${PAYSTACK_API_BASE}/transferrecipient`, {
+      type: spec.type, name: i.name.slice(0, 100), account_number: spec.accountNumber, bank_code: spec.bankCode, currency: "KES",
+    }, { headers: auth(secrets.paystack), timeout: 20_000 });
+    const code = String(res.data?.data?.recipient_code ?? "");
+    if (!res.data?.status || !/^RCP_[A-Za-z0-9]+$/.test(code)) return { ok: false, reason: "Paystack did not create the recipient" };
+    const fp = fpOf(spec.bankCode, spec.accountNumber);
+    const doc: RecipientDoc = {
+      landlordId: i.landlordId, recipientCode: code, type: spec.type, bankCode: spec.bankCode, fp, last4: spec.accountNumber.slice(-4), name: i.name, status: "active",
+      seal: sealRecipient(secrets.seal, { landlordId: i.landlordId, recipientCode: code, type: spec.type, bankCode: spec.bankCode, fp }), createdAt: Date.now(),
+    };
+    await col().doc(i.landlordId).set(doc);
+    return { ok: true };
+  } catch (err) {
+    const msg = (err as { response?: { data?: { message?: string } }; message?: string })?.response?.data?.message || (err as Error)?.message || "error";
+    console.error("LMM recipient creation failed:", msg);
+    return { ok: false, reason: String(msg).slice(0, 120) };
+  }
+}
+
+/**
+ * The recipient to pay, verified two ways: (1) the stored seal still matches (nobody edited the document), and (2) Paystack itself says
+ * this recipient code is active and still points at the account whose fingerprint we sealed. Any doubt -> alert + null.
+ */
+export async function getVerifiedRecipient(secrets: { paystack: string; seal: string }, landlordId: string): Promise<RecipientDoc | null> {
+  const snap = await col().doc(landlordId).get();
+  const r = snap.data() as RecipientDoc | undefined;
+  if (!r || r.status !== "active") { await alertOps("RECIPIENT_MISSING", `landlord ${landlordId} has no active recipient`); return null; }
+  const want = sealRecipient(secrets.seal, { landlordId, recipientCode: r.recipientCode, type: r.type, bankCode: r.bankCode, fp: r.fp });
+  if (r.landlordId !== landlordId || !sameSeal(r.seal, want)) { await alertOps("SEAL_MISMATCH", `recipient record for ${landlordId} was altered`); return null; }
+  try {
+    const res = await axios.get(`${PAYSTACK_API_BASE}/transferrecipient/${encodeURIComponent(r.recipientCode)}`, { headers: auth(secrets.paystack), timeout: 20_000 });
+    const d = res.data?.data;
+    const acct = String(d?.details?.account_number ?? "");
+    const bank = String(d?.details?.bank_code ?? "");
+    const ok = res.data?.status === true && d?.recipient_code === r.recipientCode && d?.active !== false && d?.is_deleted !== true && d?.isDeleted !== true
+      && d?.type === r.type && bank.toUpperCase() === r.bankCode.toUpperCase() && fingerprint(secrets.seal, bank, acct) === r.fp;
+    if (!ok) { await alertOps("RECIPIENT_MISMATCH", `Paystack recipient ${r.recipientCode} does not match what was sealed for ${landlordId}`); return null; }
+  } catch (err) {
+    await alertOps("RECIPIENT_MISMATCH", `could not verify recipient for ${landlordId}: ${(err as Error)?.message}`);
+    return null;
+  }
+  return r;
+}
diff --git a/functions/src/lmm/reminders.ts b/functions/src/lmm/reminders.ts
new file mode 100644
index 0000000..5fcda41
--- /dev/null
+++ b/functions/src/lmm/reminders.ts
@@ -0,0 +1,23 @@
+// When to text a tenant about a missed payment. Pure. Not spammy: a reminder only after the plan's own quiet period, never closer
+// than MIN_DAYS_BETWEEN_SMS to any earlier SMS, and at most 3 per stretch of silence (a payment resets the count).
+import { FREQUENCY_DAYS, LMM, type Frequency } from "./config";
+
+export interface ReminderInput {
+  frequency: Frequency; status: string; remainingMinor: number; createdAt: number; lastPaymentAt: number; lastSmsAt: number; missedCount: number;
+}
+const DAY = 86_400_000;
+export function missedReminder(p: ReminderInput, now: number): { send: true; days: number } | { send: false } {
+  if (p.status !== "active" || p.remainingMinor <= 0 || p.missedCount >= 3) return { send: false };
+  const since = Math.max(p.lastPaymentAt, p.createdAt);
+  const days = Math.floor((now - since) / DAY);
+  const after = LMM.MISSED_AFTER_DAYS[p.frequency];
+  if (days < after) return { send: false };
+  const gap = Math.max(LMM.MIN_DAYS_BETWEEN_SMS, FREQUENCY_DAYS[p.frequency]);
+  if (p.lastSmsAt > 0 && now - p.lastSmsAt < gap * DAY) return { send: false };
+  return { send: true, days };
+}
+/** The highest milestone newly reached (25/50/75/100 %), or null. Everything at or below it counts as sent. */
+export function newMilestone(pct: number, sent: readonly number[]): number | null {
+  const crossed = LMM.MILESTONES.filter((m) => pct >= m && !sent.includes(m));
+  return crossed.length ? crossed[crossed.length - 1] : null;
+}
diff --git a/functions/src/lmm/seal.ts b/functions/src/lmm/seal.ts
