--- /dev/null
+++ b/functions/src/lmmx/recipients.ts
@@ -0,0 +1,163 @@
+// The landlord's payout recipient (a sealed Paystack transfer recipient). Created only from a signed-in desk's request, sealed with LMM_SEAL_KEY,
+// re-verified against Paystack right before every transfer. Names and contacts are stored hashed (matching) AND encrypted (reading back).
+import axios from "axios";
+import { PAYSTACK_API_BASE, PAYSTACK_SECRET_KEY } from "../desk/paystack";
+import { fingerprint, LMM_SEAL_KEY, sameSeal, sealRecipient } from "../lmm/seal";
+import { COL, X } from "./config";
+import { LMMX, PAYSTACK_BANK_CODE, PAYSTACK_TYPE, maskName, normalizeKePhone } from "./contract";
+import type { Channel, NameMatch, RecipientInput } from "./contract";
+import { H, acctKey, enc, normName, randId, readToken, signToken, dec } from "./crypto";
+import { fail } from "./errors";
+import { alert, audit, col, now, rateOk } from "./store";
+import type { RecipientDoc } from "./types";
+import type { DeskCtx } from "./authz";
+
+const hdr = () => ({ Authorization: `Bearer ${PAYSTACK_SECRET_KEY.value()}`, "Content-Type": "application/json" });
+
+export interface Spec { channel: Channel; bankCode: string; paystackBankCode: string; accountNumber: string; type: RecipientDoc["paystackType"] }
+/** Validates and normalises the payout account. Paybill is not supported (it needs an account reference). */
+export function specOf(i: Pick<RecipientInput, "channel" | "bankCode" | "accountNumber">): Spec {
+  const channel = i.channel;
+  if (channel === "phone") {
+    const p = normalizeKePhone(i.accountNumber);
+    if (!p) return fail("LMMX_E_VALIDATION", "Enter a valid M-PESA phone number.");
+    return { channel, bankCode: "MPESA", paystackBankCode: PAYSTACK_BANK_CODE.phone!, accountNumber: "0" + p.slice(4), type: PAYSTACK_TYPE.phone };
+  }
+  const acct = String(i.accountNumber ?? "").replace(/\s+/g, "");
+  if (channel === "till") {
+    if (!/^\d{5,8}$/.test(acct)) return fail("LMMX_E_VALIDATION", "Enter a valid till number.");
+    return { channel, bankCode: "MPTILL", paystackBankCode: PAYSTACK_BANK_CODE.till!, accountNumber: acct, type: PAYSTACK_TYPE.till };
+  }
+  if (channel === "bank") {
+    const code = String(i.bankCode ?? "").trim();
+    if (!/^[A-Za-z0-9_-]{2,20}$/.test(code) || /paybill|airtel/i.test(code)) return fail("LMMX_E_VALIDATION", "Choose a bank from the list.");
+    if (!/^[A-Za-z0-9-]{5,24}$/.test(acct)) return fail("LMMX_E_VALIDATION", "Enter a valid bank account number.");
+    return { channel, bankCode: code, paystackBankCode: code, accountNumber: acct, type: PAYSTACK_TYPE.bank };
+  }
+  return fail("LMMX_E_VALIDATION", "Choose M-PESA phone, till or bank.");
+}
+
+/** Dice similarity over name words; passes with at least one shared full word and 0.6 overall. */
+export function nameMatches(entered: string, resolved: string): boolean {
+  const a = normName(entered).split(" ").filter(Boolean), b = normName(resolved).split(" ").filter(Boolean);
+  if (!a.length || !b.length) return false;
+  const common = a.filter((w) => b.includes(w)).length;
+  return common >= 1 && (2 * common) / (a.length + b.length) >= 0.6;
+}
+/** The registered name Paystack knows for a BANK account (till and phone cannot be resolved). null when unavailable. */
+async function resolveName(s: Spec): Promise<string | null> {
+  if (s.channel !== "bank") return null;
+  try {
+    const r = await axios.get(`${PAYSTACK_API_BASE}/bank/resolve`, { params: { account_number: s.accountNumber, bank_code: s.paystackBankCode }, headers: hdr(), timeout: 15_000 });
+    const n = r.data?.status ? String(r.data?.data?.account_name ?? "").trim() : "";
+    return n || null;
+  } catch { return null; }
+}
+
+export const sealOf = (r: Pick<RecipientDoc, "recipientId" | "recipientCode" | "paystackType" | "paystackBankCode" | "fp">): string =>
+  sealRecipient(LMM_SEAL_KEY.value(), { landlordId: r.recipientId, recipientCode: r.recipientCode, type: r.paystackType, bankCode: r.paystackBankCode, fp: r.fp });
+
+/** What the desk learns about an existing account: only the number and flags. Counted against a daily limit so account numbers cannot be probed. */
+export async function checkRecipient(desk: DeskCtx, i: { channel: Channel; bankCode?: string; accountNumber: string; enteredName: string }) {
+  if (!(await rateOk(`chk|${desk.uid}`, LMMX.DESK_RECIPIENT_CHECKS_PER_DAY, 86_400_000))) return fail("LMMX_E_RATE", "Too many account checks today.");
+  const s = specOf(i);
+  const key = acctKey(s.channel, s.channel === "bank" ? s.bankCode : "", s.accountNumber);
+  const snap = await col(COL.recipients).where("acctKey", "==", key).limit(5).get();
+  const live = snap.docs.map((d) => d.data() as RecipientDoc).filter((r) => r.status === "verified" || r.status === "needs_review" || r.status === "pending");
+  await audit({ action: "recipient_checked", actor: { type: desk.isTop ? "top" : "desk", deskCode: desk.deskCode, uid: desk.uid }, summary: `check ${s.channel} ...${s.accountNumber.slice(-3)} -> ${live.length ? "exists" : "new"}` });
+  const hit = live.find((r) => r.status === "verified");
+  if (!live.length) return { exists: false, accountNumber: s.accountNumber, nameMatchesEntered: false, reusable: false };
+  const nameKey = H("name", normName(i.enteredName));
+  const sameName = live.some((r) => r.nameKey === nameKey);
+  return {
+    exists: true, accountNumber: s.accountNumber, nameMatchesEntered: sameName, reusable: !!hit,
+    ...(hit ? { reuseToken: signToken("reuse", { rid: hit.recipientId, desk: desk.uid, exp: now() + 15 * 60_000 }) } : {}),
+  };
+}
+
+async function blockedByGuards(desk: DeskCtx, tenantPhone: string, contactPhone: string, s: Spec): Promise<void> {
+  const acctPhone = s.channel === "phone" ? normalizeKePhone(s.accountNumber) : null;
+  const phones = [contactPhone, acctPhone].filter((p): p is string => !!p);
+  if (phones.some((p) => p === tenantPhone)) return fail("LMMX_E_RECIPIENT_BLOCKED", "The landlord's phone cannot be the tenant's own phone.");
+  if (!desk.isTop) {
+    if (phones.some((p) => p === desk.phone)) return fail("LMMX_E_RECIPIENT_BLOCKED", "A desk cannot register its own phone as the landlord.");
+    for (const p of phones) {
+      const d = await col("desk_agents").where("phone", "==", p).limit(1).get();
+      if (!d.empty) { await alert("UNEXPECTED", `LMMX recipient equals a desk phone (desk ${desk.deskCode})`); return fail("LMMX_E_RECIPIENT_BLOCKED", "This number belongs to a desk agent and cannot be a landlord."); }
+    }
+    const own = (await col("agents").doc(desk.uid).get()).data()?.paymentInfo as { accountNumber?: unknown } | undefined;
+    if (own?.accountNumber && String(own.accountNumber).replace(/\D/g, "") === s.accountNumber.replace(/\D/g, "")) return fail("LMMX_E_RECIPIENT_BLOCKED", "A desk cannot use its own payout account as the landlord's.");
+  }
+}
+
+/** Creates a new sealed recipient, or returns the one named by a valid reuse token. Never returns a recipient that is frozen or retired. */
+export async function createOrReuseRecipient(desk: DeskCtx, tenantPhone: string, i: RecipientInput): Promise<RecipientDoc> {
+  const contactPhone = normalizeKePhone(i.contactPhone);
+  if (!contactPhone) return fail("LMMX_E_VALIDATION", "Enter a valid landlord contact phone.");
+  const name = String(i.accountName ?? "").trim(), cname = String(i.contactName ?? "").trim();
+  if (name.length < 2 || name.length > 80 || cname.length < 2 || cname.length > 80) return fail("LMMX_E_VALIDATION", "Enter the account name and the contact name.");
+  const s = specOf(i);
+  await blockedByGuards(desk, tenantPhone, contactPhone, s);
+
+  if (i.reuseToken) {
+    const t = readToken<{ rid: string; desk: string; exp: number }>("reuse", i.reuseToken);
+    if (!t || t.exp < now() || t.desk !== desk.uid) return fail("LMMX_E_VALIDATION", "That reuse code expired. Check the account again.");
+    const r = (await col(COL.recipients).doc(t.rid).get()).data() as RecipientDoc | undefined;
+    if (!r || r.status === "frozen" || r.status === "retired") return fail("LMMX_E_RECIPIENT_BLOCKED", "This landlord account cannot be reused.");
+    if (r.acctKey !== acctKey(s.channel, s.channel === "bank" ? s.bankCode : "", s.accountNumber)) return fail("LMMX_E_VALIDATION", "That reuse code is for a different account.");
+    if (r.status === "verified" && r.activeTenantCount >= LMMX.RECIPIENT_TENANTS_BEFORE_REVIEW && !r.deskCodes.every((d) => d === desk.deskCode)) {
+      await col(COL.recipients).doc(r.recipientId).update({ status: "needs_review", reviewReason: "shared_recipient" });
+      await audit({ action: "recipient_reused", actor: { type: "desk", deskCode: desk.deskCode, uid: desk.uid }, summary: `shared recipient ${r.recipientId} sent to review` });
+      await alert("UNEXPECTED", `LMMX shared recipient ${r.recipientId} across desks`);
+      return { ...r, status: "needs_review", reviewReason: "shared_recipient" };
+    }
+    await audit({ action: "recipient_reused", actor: { type: desk.isTop ? "top" : "desk", deskCode: desk.deskCode, uid: desk.uid }, summary: `reused ${r.recipientId}` });
+    return r;
+  }
+
+  const resolved = await resolveName(s);
+  const match: NameMatch = resolved === null ? "unavailable" : nameMatches(name, resolved) ? "matched" : "mismatch";
+  const recipientId = randId("RCP");
+  let code = "";
+  try {
+    const res = await axios.post(`${PAYSTACK_API_BASE}/transferrecipient`, { type: s.type, name: name.slice(0, 100), account_number: s.accountNumber, bank_code: s.paystackBankCode, currency: "KES" }, { headers: hdr(), timeout: 20_000 });
+    code = String(res.data?.data?.recipient_code ?? "");
+    if (!res.data?.status || !/^RCP_[A-Za-z0-9]+$/.test(code)) return fail("LMMX_E_VALIDATION", "Paystack could not accept this payout account.");
+  } catch (err) {
+    const msg = (err as { response?: { data?: { message?: string } } })?.response?.data?.message;
+    return fail("LMMX_E_VALIDATION", `Paystack could not accept this payout account${msg ? `: ${String(msg).slice(0, 80)}` : "."}`);
+  }
+  const fp = fingerprint(LMM_SEAL_KEY.value(), s.paystackBankCode, s.accountNumber);
+  const base = { recipientId, paystackType: s.type, paystackBankCode: s.paystackBankCode, fp, recipientCode: code };
+  const needsReview = match === "mismatch";
+  const doc: RecipientDoc = {
+    recipientId, channel: s.channel, bankCode: s.bankCode, paystackType: s.type, paystackBankCode: s.paystackBankCode, accountNumber: s.accountNumber,
+    acctKey: acctKey(s.channel, s.channel === "bank" ? s.bankCode : "", s.accountNumber), fp, recipientCode: code, seal: sealOf(base),
+    resolvedNameEnc: enc(resolved ?? name), enteredNameEnc: enc(name), nameKey: H("name", normName(name)), resolvedNameMasked: maskName(resolved ?? name), nameMatch: match,
+    contactNameEnc: enc(cname), contactKey: H("contact", contactPhone), contactPhoneEnc: enc(contactPhone), contactPhoneHash: H("phone", contactPhone),
+    status: needsReview ? "needs_review" : "verified", ...(needsReview ? { reviewReason: "name_mismatch" as const } : { verifiedAt: now() }), createdAt: now(), createdByDesk: desk.deskCode,
+    activeTenantCount: 0, deskCodes: [],
+  };
+  await col(COL.recipients).doc(recipientId).create(JSON.parse(JSON.stringify(doc)));
+  await audit({ action: "recipient_created", actor: { type: desk.isTop ? "top" : "desk", deskCode: desk.deskCode, uid: desk.uid }, summary: `recipient ${recipientId} ${s.channel} ...${s.accountNumber.slice(-3)} name:${match}` });
+  if (needsReview) await alert("UNEXPECTED", `LMMX recipient ${recipientId} name mismatch, needs top desk review`);
+  return doc;
+}
+
+/** The recipient to pay, verified two ways: the stored seal still matches AND Paystack still says it is this active account. Any doubt: alert and null. */
+export async function verifiedRecipientForPayout(recipientId: string): Promise<RecipientDoc | null> {
+  const r = (await col(COL.recipients).doc(recipientId).get()).data() as RecipientDoc | undefined;
+  if (!r || r.status !== "verified") { await alert("RECIPIENT_MISSING", `LMMX recipient ${recipientId} is not verified`); return null; }
+  if (!sameSeal(r.seal, sealOf(r))) { await alert("SEAL_MISMATCH", `LMMX recipient ${recipientId} was altered`); return null; }
+  try {
+    const res = await axios.get(`${PAYSTACK_API_BASE}/transferrecipient/${encodeURIComponent(r.recipientCode)}`, { headers: hdr(), timeout: 20_000 });
+    const d = res.data?.data;
+    const ok = res.data?.status === true && d?.recipient_code === r.recipientCode && d?.active !== false && d?.is_deleted !== true && d?.isDeleted !== true && d?.type === r.paystackType
+      && String(d?.details?.bank_code ?? "").toUpperCase() === r.paystackBankCode.toUpperCase() && fingerprint(LMM_SEAL_KEY.value(), String(d?.details?.bank_code ?? ""), String(d?.details?.account_number ?? "")) === r.fp;
+    if (!ok) { await alert("RECIPIENT_MISMATCH", `Paystack recipient ${r.recipientCode} does not match the seal`); return null; }
+  } catch (e) { await alert("RECIPIENT_MISMATCH", `could not verify recipient ${recipientId}: ${(e as Error)?.message}`); return null; }
+  return r;
+}
+export const recipientView = (r: RecipientDoc) => ({ channel: r.channel, accountNumber: r.accountNumber, resolvedNameMasked: r.resolvedNameMasked, nameMatch: r.nameMatch, status: r.status });
+export const contactOf = (r: RecipientDoc): { name: string; phone: string } => ({ name: dec(r.contactNameEnc), phone: dec(r.contactPhoneEnc) });
+void X;
diff --git a/functions/src/lmmx/settle.ts b/functions/src/lmmx/settle.ts
new file mode 100644
index 0000000..e23eccb
--- /dev/null
+++ b/functions/src/lmmx/settle.ts
@@ -0,0 +1,178 @@
+// Paying the landlord. UNCUT: the transfer is exactly the rent credited, never less. Paystack's transfer fee comes out of Samuhia's balance (recovered
+// from the reserve). Mirrors legacy: pay in full when funded (and the money is in the balance), or on the due date whatever is in; later credits go as ONE top-up.
+import axios from "axios";
+import * as crypto from "crypto";
+import { dearLine } from "../lmm/dear";
+import { minSendableMinor } from "../lmm/fees";
+import { LMM_SEAL_KEY, sameSeal, sealSettlement } from "../lmm/seal";
+import { PAYSTACK_API_BASE, PAYSTACK_SECRET_KEY } from "../desk/paystack";
+import { COL, X } from "./config";
+import { LMMX, LMMX_BRAND, eatDate, fitSms, kes, nextDueDate, transferCostMinor, LMMX_TRANSFER_REF_PREFIX } from "./contract";
+import { fail } from "./errors";
+import { alert, audit, col, db, flags, FV, ledger, now } from "./store";
+import { termsHashOf, termsSigOf, loadRecipient, nameOf, phoneOf, sms } from "./tenants";
+import { contactOf, verifiedRecipientForPayout } from "./recipients";
+import { firstName } from "../lmm/dear";
+import type { CycleDoc, PayRecordDoc, SettlementDoc, TenantDoc } from "./types";
+
+const hdr = () => ({ Authorization: `Bearer ${PAYSTACK_SECRET_KEY.value()}`, "Content-Type": "application/json" });
+const dayKey = (): string => eatDate(now()).replace(/-/g, "");
+const prevDay = (iso: string): string => new Date(Date.parse(`${iso}T00:00:00Z`) - 86_400_000).toISOString().slice(0, 10);
+const refOf = (id: string, attempt: number): string => `${LMMX_TRANSFER_REF_PREFIX}${crypto.createHash("sha256").update(id).digest("hex").slice(0, 16)}-${attempt}`;
+class Hold extends Error {}
+
+/** Decides whether this cycle can be paid out now and, if so, locks a settlement and sends it. Safe to call repeatedly. */
+export async function settleCycle(cycleId: string): Promise<string> {
+  if ((await flags()).payoutsPaused) return "held:paused";
+  const c0 = (await col(COL.cycles).doc(cycleId).get()).data() as CycleDoc | undefined;
+  if (!c0) return "none";
+  const t = (await col(COL.tenants).doc(c0.tenantId).get()).data() as TenantDoc | undefined;
+  if (!t) return "none";
+  if (t.frozen) return "held:frozen";
+  const payable0 = c0.creditedMinor - c0.settledMinor - c0.inflightMinor;
+  if (payable0 <= 0) return "none";
+  const today = eatDate(now());
+  const full = c0.creditedMinor >= c0.rentMinor, dueReached = today >= c0.dueDate;
+  const dayBeforeNext = prevDay(nextDueDate(c0.dueDate, t.dueDay, 1));
+  let reason: SettlementDoc["reason"], eligible: boolean;
+  if (full) { reason = c0.settledMinor === 0 ? "full" : "topup"; eligible = dueReached || (c0.lastAvailableOn ?? today) <= today; }
+  else if (c0.settledMinor === 0) { reason = "due_date"; eligible = dueReached; }
+  else { reason = "topup"; eligible = today >= dayBeforeNext; }
+  if (!eligible) return "held:not_due";
+
+  const rec = await loadRecipient(t.activeRecipientId);
+  const allowedAt = Math.max((rec.verifiedAt ?? Number.MAX_SAFE_INTEGER) + LMMX.FIRST_PAYOUT_MIN_RECIPIENT_AGE_MS, (t.landlordNoticeAt ?? Number.MAX_SAFE_INTEGER) + LMMX.LANDLORD_NOTICE_MIN_BEFORE_PAYOUT_MS);
+  if (now() < allowedAt) { if (dueReached) await alert("SETTLEMENT_STUCK", `LMMX payout for ${t.tenantId} is waiting for the first-payout safety window`); return "held:first_payout_window"; }
+  if (payable0 < minSendableMinor(rec.paystackType)) return "held:below_min";
+
+  const pr = (await col(COL.payRecords).doc(t.tenantId).get()).data() as PayRecordDoc | undefined;
+  const th = termsHashOf(t, rec);
+  if (!pr || pr.termsHash !== th || !sameSeal(pr.termsSig, termsSigOf(pr.termsHash)) || pr.recipientId !== rec.recipientId) {
+    await col(COL.tenants).doc(t.tenantId).update({ frozen: true, frozenReason: "terms seal mismatch", updatedAt: now() });
+    await alert("SEAL_MISMATCH", `LMMX payout terms for ${t.tenantId} do not match their seal. Tenant frozen.`);
+    await audit({ action: "tamper_detected", actor: { type: "system" }, tenantId: t.tenantId, summary: "pay record seal mismatch at payout; tenant frozen" });
+    return "held:tamper";
+  }
+
+  const dayRef = col(COL.counters).doc(`out_${dayKey()}`);
+  let sid = "";
+  try {
+    await db().runTransaction(async (tx) => {
+      const [cs, ds] = await Promise.all([tx.get(col(COL.cycles).doc(cycleId)), tx.get(dayRef)]);
+      const c = cs.data() as CycleDoc;
+      const amount = c.creditedMinor - c.settledMinor - c.inflightMinor;
+      if (amount <= 0) throw new Hold("nothing to pay");
+      const out = (ds.data()?.outMinor as number | undefined) ?? 0;
+      if (out + amount > X.OUTFLOW_CAP_MINOR) throw new Hold("daily outflow cap");
+      sid = `${cycleId}_${c.settlementCount + 1}`;
+      const reference = refOf(sid, 1);
+      const seal = sealSettlement(LMM_SEAL_KEY.value(), { id: sid, planId: cycleId, landlordId: rec.recipientId, recipientCode: rec.recipientCode, grossMinor: amount, sendMinors: [amount], paymentRefs: [] });
+      const st: SettlementDoc = { id: sid, tenantId: t.tenantId, cycleId, recipientId: rec.recipientId, recipientCode: rec.recipientCode, amountMinor: amount, reason, status: "locked", reference, attempt: 1, seal, createdAt: now(), refs: [reference], transferCostMinor: transferCostMinor(amount, rec.channel) };
+      tx.create(col(COL.settlements).doc(sid), st);
+      tx.update(col(COL.cycles).doc(cycleId), { inflightMinor: FV.increment(amount), settlementCount: FV.increment(1) });
+      tx.set(dayRef, { outMinor: FV.increment(amount) }, { merge: true });
+    });
+  } catch (e) {
+    if ((e as { code?: number }).code === 6) return "held:race";   // another worker queued the same payout a moment ago
+    if (e instanceof Hold) { if (/cap/.test(e.message)) await alert("OVER_CAP", `LMMX ${cycleId}: today's outflow cap reached`); return `held:${e.message}`; }
+    throw e;
+  }
+  await audit({ action: "settlement_started", actor: { type: "system" }, tenantId: t.tenantId, summary: `payout ${sid} queued (${reason})` });
+  await sendSettlement(sid);
+  return `queued:${sid}`;
+}
+
+export async function sendSettlement(sid: string): Promise<void> {
+  const ref = col(COL.settlements).doc(sid);
+  const st = (await ref.get()).data() as SettlementDoc | undefined;
+  if (!st || st.status !== "locked") return;
+  const want = sealSettlement(LMM_SEAL_KEY.value(), { id: sid, planId: st.cycleId, landlordId: st.recipientId, recipientCode: st.recipientCode, grossMinor: st.amountMinor, sendMinors: [st.amountMinor], paymentRefs: [] });
+  if (!sameSeal(st.seal, want)) { await ref.update({ status: "blocked" }); await alert("SEAL_MISMATCH", `LMMX settlement ${sid} was altered`); await audit({ action: "tamper_detected", actor: { type: "system" }, tenantId: st.tenantId, summary: `settlement ${sid} seal mismatch` }); return; }
+  const rec = await verifiedRecipientForPayout(st.recipientId);
+  if (!rec || rec.recipientCode !== st.recipientCode) return;   // alert already raised; stays locked and is retried
+  try {
+    const res = await axios.post(`${PAYSTACK_API_BASE}/transfer`, { source: "balance", amount: st.amountMinor, recipient: st.recipientCode, reference: st.reference, currency: "KES", reason: `Rent via ${LMMX_BRAND}` }, { headers: hdr(), timeout: 30_000 });
+    const status = String(res.data?.data?.status ?? "");
+    if (status === "otp") { await alert("OTP_REQUIRED", `Paystack wants an OTP for ${sid}. Turn off transfer confirmation in Paystack settings.`); return; }
+    if (status === "failed" || status === "reversed") { await bumpAttempt(st, status); return; }
+    await ref.update({ transferCode: String(res.data?.data?.transfer_code ?? "") });
+    if (status === "success") await finalize(sid);
+  } catch (err) {
+    const msg = String((err as { response?: { data?: { message?: string } } })?.response?.data?.message ?? (err as Error)?.message ?? "");
+    if (/balance/i.test(msg)) { await alert("LOW_BALANCE", `LMMX not enough Paystack balance for ${sid} (${st.amountMinor / 100})`); return; }
+    if (/duplicate/i.test(msg)) return;   // the first attempt did go through; the webhook or the sweep confirms it
+    await alert("TRANSFER_FAILED", `LMMX ${sid}: ${msg.slice(0, 80)}`);
+    await bumpAttempt(st, "error");
+  }
+}
+
+async function bumpAttempt(st: SettlementDoc, why: string): Promise<void> {
+  const ref = col(COL.settlements).doc(st.id);
+  if (st.attempt >= 3) {
+    await ref.update({ status: "failed" });
+    await db().runTransaction(async (tx) => { tx.update(col(COL.cycles).doc(st.cycleId), { inflightMinor: FV.increment(-st.amountMinor) }); });
+    await alert("TRANSFER_FAILED", `LMMX ${st.id} failed 3 times (${why}); held`);
+    await audit({ action: "settlement_failed", actor: { type: "system" }, tenantId: st.tenantId, summary: `${st.id} failed after 3 attempts` });
+    return;
+  }
+  const reference = refOf(st.id, st.attempt + 1);
+  await ref.update({ attempt: st.attempt + 1, reference, refs: FV.arrayUnion(reference) });
+}
+
+/** Paystack tells us a transfer reached a final state (webhook). Only references we created are looked at. */
+export async function onTransferEvent(event: string, d: { reference?: unknown; amount?: unknown; recipient?: { recipient_code?: string } }): Promise<void> {
+  const reference = String(d?.reference ?? "");
+  if (!reference.startsWith(LMMX_TRANSFER_REF_PREFIX)) return;
+  const q = await col(COL.settlements).where("refs", "array-contains", reference).limit(1).get();
+  if (q.empty) { await alert("PLAN_MISMATCH", `LMMX transfer ${reference} matches no settlement`); return; }
+  const st = q.docs[0].data() as SettlementDoc;
+  if (Number(d?.amount) !== st.amountMinor || (d?.recipient?.recipient_code && d.recipient.recipient_code !== st.recipientCode)) { await alert("AMOUNT_MISMATCH", `LMMX transfer ${reference}: amount or recipient differs`); return; }
+  if (st.status !== "locked") return;
+  if (event === "transfer.success") { await finalize(st.id); return; }
+  if (event === "transfer.failed" || event === "transfer.reversed") { await alert(event === "transfer.failed" ? "TRANSFER_FAILED" : "TRANSFER_REVERSED", `LMMX ${st.id}`); if (reference === st.reference) await bumpAttempt(st, event); }
+}
+
+/** Asks Paystack about transfers that were sent but never confirmed. */
+export async function reconcileLocked(sid: string): Promise<void> {
+  const st = (await col(COL.settlements).doc(sid).get()).data() as SettlementDoc | undefined;
+  if (!st || st.status !== "locked" || !st.transferCode) return;
+  try {
+    const res = await axios.get(`${PAYSTACK_API_BASE}/transfer/verify/${encodeURIComponent(st.reference)}`, { headers: hdr(), timeout: 20_000 });
+    const d = res.data?.data;
+    if (d?.status === "success" && Number(d.amount) === st.amountMinor) await finalize(sid);
+    else if (d?.status === "failed" || d?.status === "reversed") await onTransferEvent(`transfer.${d.status}`, { reference: st.reference, amount: st.amountMinor });
+  } catch { /* next sweep */ }
+}
+
+async function finalize(sid: string): Promise<void> {
+  const moved = await db().runTransaction(async (tx) => {
+    const sref = col(COL.settlements).doc(sid);
+    const st = (await tx.get(sref)).data() as SettlementDoc | undefined;
+    if (!st || st.status !== "locked") return null;
+    const cref = col(COL.cycles).doc(st.cycleId), tref = col(COL.tenants).doc(st.tenantId);
+    const [cs, ts] = await Promise.all([tx.get(cref), tx.get(tref)]);
+    const c = cs.data() as CycleDoc, t = ts.data() as TenantDoc;
+    const settled = c.settledMinor + st.amountMinor;
+    const done = settled >= c.rentMinor;
+    tx.update(sref, { status: "paid", paidAt: now() });
+    tx.update(cref, {
+      inflightMinor: FV.increment(-st.amountMinor), settledMinor: FV.increment(st.amountMinor), status: done ? "settled" : "partial_settled",
+      ...(done ? {} : { legRentMinor: c.rentMinor - settled, legReserveCollectedMinor: 0 }),
+    });
+    tx.update(tref, { cur: { creditedMinor: c.creditedMinor, remainingMinor: Math.max(0, c.rentMinor - c.creditedMinor), dueDate: c.dueDate }, updatedAt: now() });
+    ledger(tx, [
+      { tenantId: st.tenantId, cycleId: st.cycleId, type: "payout", amountMinor: st.amountMinor, direction: "out", ref: sid },
+      { tenantId: st.tenantId, cycleId: st.cycleId, type: "payout_fee", amountMinor: st.transferCostMinor, direction: "out", ref: sid },
+    ]);
+    return { st, c, t, settled };
+  });
+  if (!moved) return;
+  const { st, c, t, settled } = moved;
+  await audit({ action: "settlement_paid", actor: { type: "system" }, tenantId: st.tenantId, summary: `payout ${sid} paid ${st.amountMinor / 100}` });
+  const left = Math.max(0, c.rentMinor - settled);
+  const rec = await loadRecipient(st.recipientId);
+  const who = firstName(nameOf(t)) || "Your tenant";
+  await sms(`lmmx_paid_l_${sid}`, contactOf(rec).phone, fitSms(`Samuhia: ${kes(st.amountMinor)} rent from ${who} was sent to you via ${LMMX_BRAND}.${left > 0 ? ` ${kes(left)} is still expected.` : ""}`));
+  await sms(`lmmx_paid_t_${sid}`, phoneOf(t), fitSms(`${dearLine(nameOf(t))} your landlord was paid ${kes(st.amountMinor)} for rent via ${LMMX_BRAND}.${left > 0 ? ` Balance ${kes(left)} stays on your plan.` : " Thank you."}`));
+}
+void fail;
