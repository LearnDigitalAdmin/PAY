+  assert.strictEqual(C.normalizeKePhone("0101716473"), "+254101716473"); assert.strictEqual(C.firstDueDate("2026-11-15", 5), "2026-12-05"); assert.strictEqual(C.firstDueDate("2026-11-15", 28), "2026-11-28");
