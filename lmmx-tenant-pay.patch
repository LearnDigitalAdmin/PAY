+// The standalone Lipa Mdogo Mdogo app for a tenant: Home, Pay, History, Settings. Reached after `lmmx_tenant_link` (see LmmxGate).
+import { useCallback, useEffect, useState } from 'react';
+import { useNavigate } from 'react-router-dom';
+import { AuthService, auth } from '../Firebase';
+import type { TenantSummaryOut } from './contract';
+import { LmmxApiError, errorMessage, isMock, lmmx } from './api';
+import { SCENARIOS, setMockFail, setMockScenario, mockScenario } from './mock';
+import { recalledKinds } from './route';
+import Dashboard from './Dashboard';
+import HistoryPanel from './HistoryPanel';
+import PayPanel from './PayPanel';
+import SettingsPanel from './SettingsPanel';
+import { ERROR_TEXT, S } from './strings';
+import { Alert, Btn, Card, Spinner } from './ui';
+
+type Tab = 'home' | 'pay' | 'history' | 'settings';
+const TABS: Tab[] = ['home', 'pay', 'history', 'settings'];
+
+export default function LmmxApp({ demo = false }: { demo?: boolean }) {
+  const navigate = useNavigate();
+  const [s, setS] = useState<TenantSummaryOut | null>(null);
+  const [err, setErr] = useState('');
+  const [tab, setTab] = useState<Tab>('home');
+  const [tick, setTick] = useState(0);
+
+  const load = useCallback(async () => {
+    try { setS(await lmmx('lmmx_tenant_summary', {})); setErr(''); }
+    catch (e) {
+      // Not linked (or not a standalone tenant): back to the link step instead of a dead end.
+      if (!demo && e instanceof LmmxApiError && (e.lmmx === 'LMMX_E_NOT_FOUND' || e.lmmx === 'LMMX_E_NEEDS_REAUTH')) { navigate('/lmmx', { replace: true }); return; }
+      setErr(errorMessage(e, ERROR_TEXT, S.loadFailed));
+    }
+  }, [navigate, demo]);
+  useEffect(() => { void load(); }, [load]);
+  const changed = useCallback(() => { void load(); setTick((t) => t + 1); }, [load]);
+
+  const signOut = async () => { try { await AuthService.signOut(); } finally { navigate('/'); } };
+  const hasLegacy = recalledKinds().includes('legacy');
+  const defaultPhone = auth.currentUser?.phoneNumber ? `0${auth.currentUser.phoneNumber.replace(/^\+254/, '')}` : '';
+
+  return (
+    <main className="min-h-screen bg-gradient-to-br from-green-50 to-emerald-100 pb-10">
+      <header className="bg-white shadow-sm">
+        <div className="max-w-xl mx-auto px-4 py-3 flex items-center justify-between gap-3">
+          <div><h1 className="text-lg font-bold text-gray-900">{S.brand}</h1><p className="text-xs text-gray-600">{S.tagline}</p></div>
+          {!demo && <Btn tone="ghost" onClick={signOut}>{S.signOut}</Btn>}
+        </div>
+        <nav className="max-w-xl mx-auto px-2 flex" aria-label={S.brand}>
+          {TABS.map((t) => (
+            <button key={t} type="button" onClick={() => setTab(t)} aria-current={tab === t ? 'page' : undefined}
+              className={`flex-1 min-h-11 px-2 py-2 text-sm font-semibold border-b-4 ${tab === t ? 'border-green-600 text-green-800' : 'border-transparent text-gray-600'}`}>{S.tabs[t]}</button>
+          ))}
+        </nav>
+      </header>
+
+      <div className="max-w-xl mx-auto px-4 mt-4 grid gap-4">
+        {isMock() && <Alert kind="info">{S.mockBanner}</Alert>}
+        {isMock() && <MockTools />}
+        {err && <Card><Alert kind="err">{err}</Alert><div className="mt-3"><Btn tone="ghost" onClick={() => void load()}>{S.retry}</Btn></div></Card>}
+        {!s && !err && <Card><Spinner label={S.loading} /></Card>}
+        {s && tab === 'home' && <Dashboard s={s} onChanged={changed} />}
+        {s && tab === 'pay' && <PayPanel s={s} defaultPhone={defaultPhone} onPaid={changed} />}
+        {s && tab === 'history' && <HistoryPanel reloadKey={tick} />}
+        {s && tab === 'settings' && <SettingsPanel s={s} onChanged={changed} />}
+        {s && <p className="text-center text-xs text-gray-600">{S.support(s.supportPhone)}</p>}
+        {!demo && hasLegacy && <button type="button" onClick={() => navigate('/tenant')} className="text-sm text-gray-700 underline min-h-11">{S.switchToInvoice}</button>}
+      </div>
+    </main>
+  );
+}
+
+/** Demo-only controls: pick a scenario or force the next call to fail with any error code. Only rendered with VITE_LMMX_MOCK=true. */
+function MockTools() {
+  const [sc, setSc] = useState(mockScenario());
+  const codes = Object.keys(ERROR_TEXT) as Parameters<typeof setMockFail>[0][];
+  return (
+    <details className="rounded-lg border border-gray-300 bg-white p-3 text-sm">
+      <summary className="font-semibold cursor-pointer">Demo tools</summary>
+      <label className="block mt-2">Scenario
+        <select className="mt-1 w-full border rounded p-2" value={sc} onChange={(e) => { const v = e.target.value as typeof sc; setSc(v); setMockScenario(v); location.reload(); }}>
+          {SCENARIOS.map((x) => <option key={x}>{x}</option>)}
+        </select>
+      </label>
+      <label className="block mt-2">Fail the next call with
+        <select className="mt-1 w-full border rounded p-2" defaultValue="" onChange={(e) => setMockFail((e.target.value || null) as Parameters<typeof setMockFail>[0])}>
+          <option value="">(none)</option>{codes.map((c) => <option key={c}>{c}</option>)}
+        </select>
+      </label>
+    </details>
+  );
+}
diff --git a/src/lmmx/LmmxGate.tsx b/src/lmmx/LmmxGate.tsx
new file mode 100644
index 0000000..88686d3
--- /dev/null
+++ b/src/lmmx/LmmxGate.tsx
@@ -0,0 +1,106 @@
+// After a tenant signs in: find out which accounts match this phone + ID (`lmmx_tenant_link`) and send them to the right place.
+//   only Lipa Mdogo Mdogo -> /lmmx/app      only the Plot Yangu invoice -> /tenant (exactly as before)      both -> a chooser
+// A tenant who already has a rent-invoice profile is checked quietly with the ID on that profile; if anything goes wrong
+// they land on /tenant as they always did, so the existing sign-in cannot be broken by this step.
+import { useEffect, useRef, useState } from 'react';
+import { useNavigate } from 'react-router-dom';
+import { doc, getDoc } from 'firebase/firestore';
+import { db } from '../Firebase';
+import { useSession } from '../session/session';
+import { validIdNumber, type IdType } from './contract';
+import { LmmxApiError, lmmx } from './api';
+import { decideDestination, rememberKinds, type Kind } from './route';
+import { S } from './strings';
+import { Alert, Btn, Card, Field, Spinner, Title, inputClass } from './ui';
+
+export default function LmmxGate() {
+  const navigate = useNavigate();
+  const session = useSession();
+  const [stage, setStage] = useState<'checking' | 'form' | 'choose'>('checking');
+  const [idType, setIdType] = useState<IdType>('national_id');
+  const [idNumber, setIdNumber] = useState('');
+  const [busy, setBusy] = useState(false);
+  const [error, setError] = useState('');
+  const started = useRef(false);
+
+  const go = (kinds: readonly Kind[], quiet: boolean) => {
+    rememberKinds(kinds);
+    const d = decideDestination(kinds);
+    if (d === 'lmm') navigate('/lmmx/app', { replace: true });
+    else if (d === 'legacy') navigate('/tenant', { replace: true });
+    else if (d === 'choose') setStage('choose');
+    else if (quiet) navigate('/tenant', { replace: true });
+    else { setError(S.linkFailed); setBusy(false); }
+  };
+
+  useEffect(() => {
+    if (started.current || !session.user) return;
+    started.current = true;
+    (async () => {
+      try {
+        const snap = await getDoc(doc(db, 'tenants', session.user!.uid));
+        if (!snap.exists()) { setStage('form'); return; }          // a new person: ask for the ID
+        const id = String(snap.data().idNumber ?? '').trim();
+        if (!validIdNumber('national_id', id)) { navigate('/tenant', { replace: true }); return; }
+        const out = await lmmx('lmmx_tenant_link', { idType: 'national_id', idNumber: id });
+        go(out.kinds, true);
+      } catch { navigate('/tenant', { replace: true }); }
+    })();
+    // eslint-disable-next-line react-hooks/exhaustive-deps
+  }, [session.user]);
+
+  const submit = async () => {
+    const id = idNumber.trim();
+    if (!validIdNumber(idType, id)) { setError(S.idInvalid); return; }
+    setBusy(true); setError('');
+    try {
+      const out = await lmmx('lmmx_tenant_link', { idType, idNumber: id });
+      go(out.kinds, false);
+    } catch (e) {
+      // One generic failure for a wrong phone and a wrong ID: never say which one did not match.
+      setError(e instanceof LmmxApiError && e.lmmx === 'LMMX_E_RATE' ? S.linkRate : e instanceof LmmxApiError && e.network ? S.linkNetwork : S.linkFailed);
+      setBusy(false);
+    }
+  };
+
+  const shell = (children: React.ReactNode) => <main className="min-h-screen bg-gradient-to-br from-green-50 to-emerald-100 p-4 flex items-start sm:items-center justify-center"><div className="w-full max-w-md">{children}</div></main>;
+
+  if (stage === 'checking') return shell(<Card><Spinner label={S.checking} /></Card>);
+
+  if (stage === 'choose') {
+    return shell(
+      <Card>
+        <Title>{S.chooserTitle}</Title>
+        <div className="mt-4 grid gap-3">
+          <button type="button" onClick={() => navigate('/tenant', { replace: true })} className="text-left min-h-11 rounded-xl border-2 border-gray-200 p-4 hover:border-green-600 focus:outline-none focus:ring-2 focus:ring-green-600">
+            <span className="block font-bold text-gray-900">{S.chooserLegacyTitle}</span><span className="block text-sm text-gray-600">{S.chooserLegacyBody}</span>
+          </button>
+          <button type="button" onClick={() => navigate('/lmmx/app', { replace: true })} className="text-left min-h-11 rounded-xl border-2 border-gray-200 p-4 hover:border-green-600 focus:outline-none focus:ring-2 focus:ring-green-600">
+            <span className="block font-bold text-gray-900">{S.chooserLmmTitle}</span><span className="block text-sm text-gray-600">{S.chooserLmmBody}</span>
+          </button>
+        </div>
+      </Card>
+    );
+  }
+
+  return shell(
+    <Card>
+      <Title>{S.linkTitle}</Title>
+      <p className="mt-1 text-sm text-gray-600">{S.linkIntro}</p>
+      <div className="mt-4 grid gap-3">
+        <Field label={S.idTypeLabel}>
+          <select className={inputClass} value={idType} onChange={(e) => setIdType(e.target.value as IdType)} disabled={busy}>
+            {(Object.keys(S.idTypes) as IdType[]).map((t) => <option key={t} value={t}>{S.idTypes[t]}</option>)}
+          </select>
+        </Field>
+        <Field label={S.idNumberLabel} hint={S.idNumberHint(idType)}>
+          <input className={inputClass} value={idNumber} autoComplete="off" inputMode={idType === 'passport' ? 'text' : 'numeric'} maxLength={9} disabled={busy}
+            onChange={(e) => { setIdNumber(e.target.value); setError(''); }} onKeyDown={(e) => { if (e.key === 'Enter' && !busy) void submit(); }} />
+        </Field>
+        {error && <Alert kind="err">{error}</Alert>}
+        <Btn onClick={submit} disabled={busy || !idNumber.trim()}>{busy ? S.linking : S.linkButton}</Btn>
+        <button type="button" onClick={() => navigate('/tenant', { replace: true })} className="text-sm text-gray-600 underline min-h-11">{S.linkSkip}</button>
+      </div>
+    </Card>
+  );
+}
diff --git a/src/lmmx/PayPanel.tsx b/src/lmmx/PayPanel.tsx
new file mode 100644
index 0000000..4ff0ab9
--- /dev/null
+++ b/src/lmmx/PayPanel.tsx
@@ -0,0 +1,157 @@
+// Pay tab: amount -> live server quote (rent / fees / you pay) -> M-PESA number -> STK prompt -> wait for the SERVER to show the
+// credit. The screen never says "received" until `lmmx_tenant_summary` shows the credit (or history shows the failure).
+import { useCallback, useEffect, useMemo, useRef, useState } from 'react';
+import { LMMX, kes, normalizeKePhone, quoteInstalment, type TenantQuoteOut, type TenantSummaryOut } from './contract';
+import { LmmxApiError, errorMessage, lmmx } from './api';
+import { ERROR_FALLBACK, ERROR_TEXT, S } from './strings';
+import { Alert, Btn, Card, Field, Spinner, Title, inputClass } from './ui';
+
+type Stage = 'form' | 'sending' | 'waiting' | 'success' | 'failed' | 'timeout';
+const POLL_MS = 4000;
+const GIVE_UP_MS = 120_000;
+const localPhone = (e164: string) => (e164.startsWith('+254') ? `0${e164.slice(4)}` : e164);
+
+export default function PayPanel({ s, defaultPhone, onPaid }: { s: TenantSummaryOut; defaultPhone: string; onPaid: () => void }) {
+  const remaining = s.cycle?.remainingMinor ?? 0;
+  const [amount, setAmount] = useState('');
+  const [phone, setPhone] = useState(defaultPhone);
+  const [quote, setQuote] = useState<TenantQuoteOut | null>(null);
+  const [quoting, setQuoting] = useState(false);
+  const [note, setNote] = useState<{ kind: 'err' | 'info'; text: string } | null>(null);
+  const [stage, setStage] = useState<Stage>('form');
+  const paid = useRef<{ baseline: number; credit: number; since: number; charge: number; phone: string } | null>(null);
+  const seq = useRef(0);
+
+  const n = amount === '' ? NaN : Number(amount);
+  const minor = n * 100;
+  const maxKes = LMMX.MAX_CREDIT_MINOR / 100;
+  const isLast = Number.isInteger(n) && minor === remaining;       // the last instalment may be smaller than the minimum
+  // The server decides what may be paid (LMMX_E_AMOUNT); here only the shape and the contract's limits are checked.
+  const valid = Number.isInteger(n) && n <= maxKes && (minor >= LMMX.MIN_CREDIT_MINOR || isLast) && minor > 0;
+  const phoneE164 = normalizeKePhone(phone);
+  const blocked = !!s.frozen || s.status !== 'active';
+
+  // Instant preview from the contract's fee engine, until the server's exact quote arrives.
+  const preview = useMemo(() => (valid ? quoteInstalment({ creditMinor: minor, rentMinor: s.rentMinor, channel: s.recipient.channel, remainingRentMinor: remaining || undefined }) : null), [valid, minor, s.rentMinor, s.recipient.channel, remaining]);
+
+  // Live quote, debounced; a newer keystroke makes an older answer harmless.
+  useEffect(() => {
+    setQuote(null);
+    if (!valid || blocked || stage !== 'form') return;
+    const mine = ++seq.current;
+    setQuoting(true);
+    const t = setTimeout(async () => {
+      try {
+        const q = await lmmx('lmmx_tenant_quote', { creditMinor: minor });
+        if (mine === seq.current) { setQuote(q); setNote(null); }
+      } catch (e) { if (mine === seq.current) setNote({ kind: 'err', text: errorMessage(e, ERROR_TEXT, S.quoteFailed) }); }
+      finally { if (mine === seq.current) setQuoting(false); }
+    }, 500);
+    return () => { clearTimeout(t); };
+  }, [valid, minor, blocked, stage]);
+
+  const lines = quote ?? preview;
+  const exact = !!quote;
+
+  const pay = async () => {
+    if (!valid || !phoneE164 || !quote) return;
+    if (quote.expiresAt <= Date.now()) {
+      try { setQuote(await lmmx('lmmx_tenant_quote', { creditMinor: minor })); setNote({ kind: 'info', text: S.quoteExpired }); }
+      catch (e) { setNote({ kind: 'err', text: errorMessage(e, ERROR_TEXT, S.quoteFailed) }); }
+      return;
+    }
+    setStage('sending'); setNote(null);
+    try {
+      await lmmx('lmmx_tenant_pay', { quoteId: quote.quoteId, payerPhone: phoneE164 });
+      paid.current = { baseline: s.cycle?.creditedMinor ?? 0, credit: quote.creditMinor, since: Date.now(), charge: quote.chargeMinor, phone: phoneE164 };
+      setStage('waiting');
+    } catch (e) {
+      setStage('form');
+      if (e instanceof LmmxApiError && e.lmmx === 'LMMX_E_QUOTE') {
+        try { setQuote(await lmmx('lmmx_tenant_quote', { creditMinor: minor })); } catch { /* the error below is enough */ }
+      }
+      setNote({ kind: 'err', text: errorMessage(e, ERROR_TEXT, ERROR_FALLBACK) });
+    }
+  };
+
+  // While waiting: ask the server (summary, and history for a decline) until it shows the outcome. No guessing.
+  const check = useCallback(async (): Promise<boolean> => {
+    const p = paid.current; if (!p) return true;
+    try {
+      const [sum, hist] = await Promise.all([lmmx('lmmx_tenant_summary', {}), lmmx('lmmx_tenant_history', {})]);
+      if ((sum.cycle?.creditedMinor ?? 0) >= p.baseline + p.credit) { setStage('success'); onPaid(); return true; }
+      if (hist.items.some((i) => i.status === 'failed' && i.at >= p.since - 5000 && i.chargeMinor === p.charge)) { setStage('failed'); return true; }
+    } catch { /* keep waiting; the next check tries again */ }
+    return false;
+  }, [onPaid]);
+
+  useEffect(() => {
+    if (stage !== 'waiting') return;
+    const p = paid.current;
+    const id = setInterval(async () => {
+      if (await check()) { clearInterval(id); return; }
+      if (p && Date.now() - p.since > GIVE_UP_MS) { clearInterval(id); setStage('timeout'); }
+    }, POLL_MS);
+    return () => clearInterval(id);
+  }, [stage, check]);
+
+  const reset = () => { paid.current = null; setAmount(''); setQuote(null); setNote(null); setStage('form'); };
+
+  if (stage === 'sending') return <Card><Spinner label={S.paying} /></Card>;
+
+  if (stage === 'waiting' || stage === 'timeout') {
+    const p = paid.current;
+    return (
+      <Card>
+        <Title>{stage === 'waiting' ? S.waitingTitle : S.timeoutTitle}</Title>
+        {stage === 'waiting' && p && <p className="mt-2 text-sm text-gray-800">{S.waitingBody(localPhone(p.phone), kes(p.charge))}</p>}
+        {stage === 'waiting' ? <div className="mt-3"><Spinner label={S.waitingNote} /></div> : <p className="mt-2 text-sm text-gray-800">{S.timeoutBody}</p>}
+        <div className="mt-4 flex flex-wrap gap-3">
+          <Btn tone="ghost" onClick={() => void check()}>{S.checkNow}</Btn>
+          {stage === 'waiting' && <Btn tone="ghost" onClick={() => setStage('failed')}>{S.didNotGetPrompt}</Btn>}
+          {stage === 'timeout' && <Btn tone="ghost" onClick={reset}>{S.done}</Btn>}
+        </div>
+      </Card>
+    );
+  }
+  if (stage === 'success') {
+    return <Card><Alert kind="ok"><strong>{S.successTitle}</strong><br />{S.successBody(kes(paid.current?.credit ?? 0))}</Alert><div className="mt-4"><Btn onClick={reset}>{S.done}</Btn></div></Card>;
+  }
+  if (stage === 'failed') {
+    return <Card><Alert kind="err"><strong>{S.failedTitle}</strong><br />{S.failedBody}</Alert><div className="mt-4"><Btn onClick={reset}>{S.payAgain}</Btn></div></Card>;
+  }
+
+  const quick = Array.from(new Set([s.suggestedCreditMinor, s.suggestedCreditMinor * 2, remaining])).filter((q) => q >= LMMX.MIN_CREDIT_MINOR && q <= remaining && q % 100 === 0).slice(0, 3);
+
+  return (
+    <Card>
+      <Title>{S.payTitle}</Title>
+      {blocked && <div className="mt-3"><Alert kind="warn">{s.frozen ? S.frozenBody(s.supportPhone) : ERROR_TEXT.LMMX_E_STATE}</Alert></div>}
+      <div className="mt-3 grid gap-3">
+        <Field label={S.amountLabel} hint={`${S.amountHint(kes(LMMX.MIN_CREDIT_MINOR), kes(LMMX.MAX_CREDIT_MINOR))} ${S.amountLastSmaller}`} error={amount !== '' && !valid ? S.amountInvalid : undefined}>
+          <input className={inputClass} inputMode="numeric" value={amount} placeholder={s.suggestedCreditMinor ? String(Math.ceil(s.suggestedCreditMinor / 100)) : '500'} disabled={blocked}
+            onChange={(e) => setAmount(e.target.value.replace(/\D/g, '').slice(0, 7))} />
+        </Field>
+        {quick.length > 0 && (
+          <div role="group" aria-label={S.quickLabel} className="flex flex-wrap gap-2">
+            {quick.map((q) => <Btn key={q} tone="ghost" disabled={blocked} onClick={() => setAmount(String(q / 100))}>{q === remaining && q !== s.suggestedCreditMinor ? `${S.quickFull} ${kes(q)}` : kes(q)}</Btn>)}
+          </div>
+        )}
+        <Field label={S.phoneLabel} hint={S.phoneHint} error={phone !== '' && !phoneE164 ? S.phoneInvalid : undefined}>
+          <input className={inputClass} inputMode="tel" autoComplete="tel" value={phone} placeholder="0712 345 678" disabled={blocked} onChange={(e) => setPhone(e.target.value)} />
+        </Field>
+
+        {lines && (
+          <dl className="rounded-lg bg-gray-50 p-3 text-sm" aria-live="polite">
+            <div className="flex justify-between py-1"><dt className="text-gray-600">{S.linesGoes}</dt><dd className="font-semibold">{kes(lines.creditMinor)}</dd></div>
+            <div className="flex justify-between py-1"><dt className="text-gray-600">{S.linesFees}</dt><dd className="font-semibold">{kes(lines.feesMinor)}</dd></div>
+            <div className="flex justify-between py-1 border-t border-gray-200 mt-1 pt-2"><dt className="font-semibold text-gray-900">{S.linesPay}</dt><dd className="font-bold text-gray-900">{kes(lines.chargeMinor)}</dd></div>
+            <p className="mt-1 text-xs text-gray-500">{exact ? '' : quoting ? S.quoting : S.estimate}</p>
+          </dl>
+        )}
+        {note && <Alert kind={note.kind}>{note.text}</Alert>}
+        <Btn onClick={pay} disabled={blocked || !valid || !phoneE164 || !quote || quoting}>{quote ? S.payButton(kes(quote.chargeMinor)) : S.payButton(valid ? kes(minor) : '')}</Btn>
+      </div>
+    </Card>
+  );
+}
diff --git a/src/lmmx/SettingsPanel.tsx b/src/lmmx/SettingsPanel.tsx
new file mode 100644
index 0000000..929741a
--- /dev/null
+++ b/src/lmmx/SettingsPanel.tsx
@@ -0,0 +1,74 @@
+// Settings tab: change the due day (next cycle, with the lock rules explained) and how often / how much the tenant plans to pay.
+import { useState } from 'react';
+import { LMMX, isValidCredit, shortDate, type Frequency, type TenantSummaryOut } from './contract';
+import { LmmxApiError, errorMessage, lmmx } from './api';
+import { ERROR_FALLBACK, ERROR_TEXT, S } from './strings';
+import { Alert, Btn, Card, Field, Title, inputClass } from './ui';
+
+export default function SettingsPanel({ s, onChanged }: { s: TenantSummaryOut; onChanged: () => void }) {
+  const [day, setDay] = useState(String(s.dueDay));
+  const [dayBusy, setDayBusy] = useState(false);
+  const [dayNote, setDayNote] = useState<{ kind: 'ok' | 'err'; text: string } | null>(null);
+  const [freq, setFreq] = useState<Frequency>(s.frequency);
+  const [sugg, setSugg] = useState(String(s.suggestedCreditMinor / 100));
+  const [planBusy, setPlanBusy] = useState(false);
+  const [planNote, setPlanNote] = useState<{ kind: 'ok' | 'err'; text: string } | null>(null);
+  const frozen = !!s.frozen || s.status !== 'active';
+
+  const saveDay = async () => {
+    const d = Number(day);
+    if (!Number.isInteger(d) || d < LMMX.DUE_DAY_MIN || d > LMMX.DUE_DAY_MAX) { setDayNote({ kind: 'err', text: S.dueDayLabel }); return; }
+    setDayBusy(true); setDayNote(null);
+    try {
+      const r = await lmmx('lmmx_tenant_setDueDay', { dueDay: d });
+      setDayNote({ kind: 'ok', text: S.dueDaySaved(shortDate(r.effectiveFromCycleDate)) }); onChanged();
+    } catch (e) {
+      // LMMX_E_STATE = already changed this cycle, or inside the lock window before the due date
+      setDayNote({ kind: 'err', text: e instanceof LmmxApiError && e.lmmx === 'LMMX_E_STATE' ? S.dueDayState : errorMessage(e, ERROR_TEXT, ERROR_FALLBACK) });
+    } finally { setDayBusy(false); }
+  };
+
+  const savePlan = async () => {
+    const n = sugg.trim() === '' ? undefined : Number(sugg);
+    const minor = n === undefined ? undefined : n * 100;
+    if (minor !== undefined && !isValidCredit(minor)) { setPlanNote({ kind: 'err', text: S.amountInvalid }); return; }
+    setPlanBusy(true); setPlanNote(null);
+    try { await lmmx('lmmx_tenant_setPlan', minor === undefined ? { frequency: freq } : { frequency: freq, suggestedCreditMinor: minor }); setPlanNote({ kind: 'ok', text: S.planSaved }); onChanged(); }
+    catch (e) { setPlanNote({ kind: 'err', text: errorMessage(e, ERROR_TEXT, ERROR_FALLBACK) }); } finally { setPlanBusy(false); }
+  };
+
+  return (
+    <div className="grid gap-4">
+      <Card>
+        <Title>{S.dueDayTitle}</Title>
+        <p className="mt-1 text-sm text-gray-600">{S.dueDayHelp}</p>
+        <div className="mt-3 flex gap-2 items-end">
+          <div className="flex-1"><Field label={S.dueDayLabel}>
+            <select className={inputClass} value={day} onChange={(e) => setDay(e.target.value)} disabled={dayBusy || frozen}>
+              {Array.from({ length: LMMX.DUE_DAY_MAX }, (_, i) => i + 1).map((d) => <option key={d} value={d}>{d}</option>)}
+            </select>
+          </Field></div>
+          <Btn onClick={saveDay} disabled={dayBusy || frozen || Number(day) === s.dueDay}>{dayBusy ? S.linking : S.dueDaySave}</Btn>
+        </div>
+        {dayNote && <div className="mt-3"><Alert kind={dayNote.kind}>{dayNote.text}</Alert></div>}
+      </Card>
+
+      <Card>
+        <Title>{S.planTitle}</Title>
+        <p className="mt-1 text-sm text-gray-600">{S.planHelp}</p>
+        <div className="mt-3 grid gap-3">
+          <Field label={S.frequencyLabel}>
+            <select className={inputClass} value={freq} onChange={(e) => setFreq(e.target.value as Frequency)} disabled={planBusy || frozen}>
+              {(Object.keys(S.frequencies) as Frequency[]).map((f) => <option key={f} value={f}>{S.frequencies[f]}</option>)}
+            </select>
+          </Field>
+          <Field label={S.suggestedLabel}>
+            <input className={inputClass} inputMode="numeric" value={sugg} onChange={(e) => setSugg(e.target.value.replace(/\D/g, ''))} disabled={planBusy || frozen} />
+          </Field>
+          <Btn onClick={savePlan} disabled={planBusy || frozen}>{planBusy ? S.linking : S.planSave}</Btn>
+          {planNote && <Alert kind={planNote.kind}>{planNote.text}</Alert>}
+        </div>
+      </Card>
+    </div>
+  );
+}
diff --git a/src/lmmx/api.ts b/src/lmmx/api.ts
new file mode 100644
index 0000000..e44fa3f
--- /dev/null
+++ b/src/lmmx/api.ts
@@ -0,0 +1,45 @@
+// Typed wrapper over the lmmx_tenant_* callables (contract section 4). With VITE_LMMX_MOCK=true every op is answered from
+// mock.ts, so the whole app can be tried without CORE. Errors carry PAY's `details.lmmx` code as `.lmmx`.
+import { httpsCallable } from 'firebase/functions';
+import { functions } from '../Firebase';
+import type { LmmxCallableMap, LmmxErrorCode } from './contract';
+import { mockCall } from './mock';
+
+export type TenantOp = Extract<keyof LmmxCallableMap, `lmmx_tenant_${string}`>;
+export const isMock = (): boolean => import.meta.env.VITE_LMMX_MOCK === 'true';
+
+export class LmmxApiError extends Error {
+  lmmx?: LmmxErrorCode;
+  /** Optional extras PAY may add to `details` (not in the contract): tries left on a wrong code. */
+  attemptsLeft?: number;
+  /** True when no answer came back at all (offline, timeout), as opposed to PAY refusing. */
+  network: boolean;
+  constructor(message: string, lmmx?: LmmxErrorCode, attemptsLeft?: number, network = false) {
+    super(message);
+    this.name = 'LmmxApiError';
+    this.lmmx = lmmx;
+    this.attemptsLeft = attemptsLeft;
+    this.network = network;
+  }
+}
+
+export async function lmmx<K extends TenantOp>(op: K, data: LmmxCallableMap[K]['in']): Promise<LmmxCallableMap[K]['out']> {
+  if (isMock()) return (await mockCall(op, data as Record<string, unknown>)) as LmmxCallableMap[K]['out'];
+  try {
+    const res = await httpsCallable<LmmxCallableMap[K]['in'], LmmxCallableMap[K]['out']>(functions, op)(data);
+    return res.data;
+  } catch (e) {
+    const err = e as { code?: string; message?: string; details?: { lmmx?: LmmxErrorCode; attemptsLeft?: number } };
+    const network = !err.details?.lmmx && (err.code === 'functions/unavailable' || err.code === 'functions/deadline-exceeded' || !err.code);
+    throw new LmmxApiError(err.message || 'Request failed', err.details?.lmmx, err.details?.attemptsLeft, network);
+  }
+}
+
+/** The text a tenant should read for any failure. */
+export function errorMessage(e: unknown, table: Partial<Record<LmmxErrorCode, string>>, fallback: string): string {
+  if (e instanceof LmmxApiError) {
+    if (e.lmmx && table[e.lmmx]) return table[e.lmmx] as string;
+    if (e.network) return 'We could not reach the server. Check your internet and try again.';
+  }
+  return fallback;
+}
diff --git a/src/lmmx/contract.ts b/src/lmmx/contract.ts
